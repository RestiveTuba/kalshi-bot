[Unit]
Description=Kalshi Market Maker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/kalshi-bot
EnvironmentFile=-/root/kalshi-bot/.env
ExecStart=/usr/bin/python3 -u /root/kalshi-bot/market_maker.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
